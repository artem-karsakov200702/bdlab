SELECT
    s."ФИО",
    COUNT(n."id_начисления") AS "Количество_начислений",
    SUM(n."Количество_часов") AS "Всего_часов"
FROM "Sotrudnik" s
JOIN "Nachislenie" n
ON s."id_сотрудника" = n."id_сотрудника"
GROUP BY s."id_сотрудника", s."ФИО";

